# API ARRAY local integration template
# Copy this file to .env and fill every value before starting the Publisher.
# Never commit .env or paste these values into chat, logs, fixtures, or JSONL files.

# Upstream OpenAI-compatible base URL, usually ending in /v1.
APIARRAY_UPSTREAM_BASE_URL=

# Exact upstream model ID used for the public alias "smart".
APIARRAY_UPSTREAM_MODEL=

# Upstream provider API key. Resolved only through secret_env.
APIARRAY_UPSTREAM_API_KEY=

# Local Publisher Bearer token. Use a new random value, not an upstream API key.
APIARRAY_PUBLISHER_TOKEN=

