{
  "name": "@apiarray/desktop",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node ./node_modules/@tauri-apps/cli/tauri.js dev",
    "dev:web": "node ./node_modules/next/dist/bin/next dev --hostname 127.0.0.1 --port 3000",
    "build": "node ./node_modules/next/dist/bin/next build",
    "test": "vitest run",
    "tauri": "node ./node_modules/@tauri-apps/cli/tauri.js",
    "tauri:dev": "npm.cmd run dev",
    "build:desktop:debug": "npm.cmd run build && node ./node_modules/@tauri-apps/cli/tauri.js build --debug",
    "build:app": "node ./node_modules/@tauri-apps/cli/tauri.js build",
    "tauri:build": "npm.cmd run build:app",
    "tauri:build:debug": "node ./node_modules/@tauri-apps/cli/tauri.js build --debug",
    "version:sync": "node ./scripts/sync-version.mjs",
    "release:preflight": "node ./scripts/release-preflight.mjs",
    "release:verify": "node ./scripts/release-verify.mjs",
    "release:msi": "npm.cmd run release:preflight && npm.cmd run release:verify && node ./scripts/build-msi.mjs && node ./scripts/package-release.mjs"
  },
  "dependencies": {
    "@openai/apps-sdk-ui": "0.2.2",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-autostart": "2.5.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@xyflow/react": "12.11.2",
    "next": "16.2.10",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
