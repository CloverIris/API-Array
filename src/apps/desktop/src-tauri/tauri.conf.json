{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "API ARRAY",
  "version": "1.0.0",
  "identifier": "com.apiarray.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev:web",
    "beforeBuildCommand": "npm.cmd run build",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "API ARRAY",
        "width": 1440,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 680,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; connect-src 'self' http://localhost:3000 http://127.0.0.1:3000;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
